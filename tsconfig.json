{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "module": "NodeNext",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": false,
  },
  "include": [
    "./src/**/*.ts",
    "src/ui"
  ],
  "exclude": [
    "node_modules"
  ],
}